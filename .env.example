# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose `db` service) ---
POSTGRES_USER=blackkite
POSTGRES_PASSWORD=change-me
POSTGRES_DB=blackkite
# Outside compose (e.g. `make migrate` on the host). Compose sets its own value for `api`.
BK_DATABASE_URL=postgresql+psycopg://blackkite:change-me@localhost:5432/blackkite
# Tests: a server where the user may CREATE DATABASE. Leave empty to let pytest
# start a throwaway local cluster (needs postgresql-16 + postgresql-16-pgvector).
BK_TEST_DATABASE_URL=
# Optional: directory holding initdb/pg_ctl for the throwaway test cluster.
BK_PG_BIN=/usr/lib/postgresql/16/bin

# --- Web / auth ---
BK_PUBLIC_BASE_URL=http://localhost:8000
BK_AFTER_LOGIN_URL=/
BK_SESSION_COOKIE_NAME=bk_session
# true in production (HTTPS). false only for local http development.
BK_COOKIE_SECURE=false
BK_SESSION_DAYS=30
BK_LOGIN_TOKEN_MINUTES=15
BK_INVITE_DAYS=7
BK_LINK_RATE_PER_EMAIL_PER_HOUR=5
BK_LINK_RATE_PER_IP_PER_HOUR=20
# Peer addresses whose X-Forwarded-For / X-Forwarded-Proto headers uvicorn trusts
# (comma-separated IPs or CIDRs; used by api/Dockerfile). Set it to the address the
# reverse proxy connects from as seen inside the container (with compose port
# publishing that is usually the bridge gateway, e.g. 172.18.0.1). Never '*'.
# The reverse proxy MUST overwrite X-Forwarded-For with the real client address
# (nginx: proxy_set_header X-Forwarded-For $remote_addr; Caddy does this by
# default), not append to it, or a client could choose its own rate-limit key.
BK_FORWARDED_ALLOW_IPS=127.0.0.1

# --- Mail: console | smtp. Dev SMTP target is Mailpit (compose profile dev). ---
BK_MAIL_TRANSPORT=console
BK_MAIL_FROM=Blackkite <no-reply@example.com>
BK_SMTP_HOST=mailpit
BK_SMTP_PORT=1025
BK_SMTP_USERNAME=
BK_SMTP_PASSWORD=
BK_SMTP_STARTTLS=false

# --- Bootstrap: the first admin (decision 15). Real address only in your own .env. ---
BK_FIRST_ADMIN_EMAIL=owner@example.com

# --- Models (decision 14) ---
BK_MODEL_EXTRACT=claude-haiku-5-5
BK_MODEL_SCORE=claude-haiku-5-5
BK_MODEL_DIGEST=claude-opus-5-5

# --- Third-party keys ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
BRAVE_API_KEY=
