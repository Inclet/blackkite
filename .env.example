# Copy to .env and fill in. Never commit .env.

# --- Environment: dev on your machine, prod on the VPS. ---
# Dev-only commands (`bk demo-seed`) refuse to run unless this is dev.
# docker-compose.yml defaults it to prod; set BK_ENV=dev here for local compose.
BK_ENV=dev

# --- Database (docker compose `db` service) ---
POSTGRES_USER=blackkite
# Required: compose refuses to start the db without it. Use a random value
# (e.g. `openssl rand -hex 24`). Example values such as change-me are refused.
POSTGRES_PASSWORD=
POSTGRES_DB=blackkite
# Outside compose (e.g. `make migrate` on the host). Compose sets its own value for
# `api` and `worker`. Uncomment and put the POSTGRES_PASSWORD value after the colon:
# BK_DATABASE_URL=postgresql+psycopg://blackkite:@localhost:5432/blackkite
# Tests: a server where the user may CREATE DATABASE. Leave empty to let pytest
# start a throwaway local cluster (needs postgresql-16 + postgresql-16-pgvector).
BK_TEST_DATABASE_URL=
# Optional: directory holding initdb/pg_ctl for the throwaway test cluster.
BK_PG_BIN=/usr/lib/postgresql/16/bin

# --- Web / auth ---
# Origin of the WEB app (not the API). Emailed sign-in/invite links go to
# {BK_WEB_BASE_URL}/auth/confirm#token=... ; the token is in the fragment so it
# never reaches a server log or Referer. The web app proxies only the exact API
# paths /auth/verify, /auth/request-link, /auth/logout, /me, /admin/* and
# /api/* (member routes: feed, profiles, sources, ...) to the
# API; /auth/confirm is a web page and must NOT be proxied.
# Only BK_WEB_BASE_URL sets this. The old BK_PUBLIC_BASE_URL is ignored (a
# warning is logged at startup if it is still set); remove it from your .env.
BK_WEB_BASE_URL=http://localhost:5173
BK_AFTER_LOGIN_URL=/
BK_SESSION_COOKIE_NAME=bk_session
# true in production (HTTPS). false only for local http development.
BK_COOKIE_SECURE=false
BK_SESSION_DAYS=30
BK_LOGIN_TOKEN_MINUTES=15
BK_INVITE_DAYS=7
BK_LINK_RATE_PER_EMAIL_PER_HOUR=5
BK_LINK_RATE_PER_IP_PER_HOUR=20
# One-click unsubscribe: per link (token) per hour, and a per-address flood
# ceiling (mail providers POST from shared addresses, so keep it generous).
BK_UNSUBSCRIBE_RATE_PER_TOKEN_PER_HOUR=10
BK_UNSUBSCRIBE_RATE_PER_IP_PER_HOUR=300
# Peer addresses whose X-Forwarded-For / X-Forwarded-Proto headers uvicorn trusts
# (comma-separated IPs or CIDRs; used by api/Dockerfile). Set it to the address the
# reverse proxy connects from as seen inside the container (with compose port
# publishing that is usually the bridge gateway, e.g. 172.18.0.1). Never '*'.
# The reverse proxy MUST overwrite X-Forwarded-For with the real client address
# (nginx: proxy_set_header X-Forwarded-For $remote_addr; Caddy does this by
# default), not append to it, or a client could choose its own rate-limit key.
BK_FORWARDED_ALLOW_IPS=127.0.0.1
# Source suggestions a member may send in any 24 hours (more get 429).
BK_SUGGESTIONS_PER_USER_PER_DAY=10
# Admin test runs in progress at once, every collector type counted (browser_list
# asks the renderer service for a headless Chromium); more get 429 "try again in a minute".
BK_TEST_RUNS_MAX_CONCURRENT=2

# --- Mail: console | smtp | resend. Dev SMTP target is Mailpit (compose profile dev). ---
# resend posts to Resend's HTTP API (decision 45) and needs RESEND_API_KEY and
# BK_MAIL_FROM (a sender on a domain verified with Resend).
BK_MAIL_TRANSPORT=console
BK_MAIL_FROM=Blackkite <no-reply@example.com>
# Safety switch: while false, the resend transport sends nothing and only logs
# what it would have sent. Set true only with the owner's go-ahead.
BK_MAIL_ALLOW_REAL_SEND=false
BK_SMTP_HOST=mailpit
BK_SMTP_PORT=1025
BK_SMTP_USERNAME=
BK_SMTP_PASSWORD=
BK_SMTP_STARTTLS=false
# One-click unsubscribe (decision 43). Every digest and alert carries a link signed
# with this secret; digests and alerts are not sent without it. At least 32
# characters, random (e.g. `openssl rand -hex 32`); example values and strings
# with fewer than 12 different characters are refused at startup. Changing it
# revokes every unsubscribe link already sent.
BK_UNSUBSCRIBE_SECRET=
# Public origin of the API for the List-Unsubscribe one-click URL
# ({BK_API_PUBLIC_URL}/api/unsubscribe?token=...). Empty: BK_WEB_BASE_URL, which
# proxies /api/* to the API.
BK_API_PUBLIC_URL=
# Optional address for a List-Unsubscribe mailto: link. Empty: no mailto.
BK_UNSUBSCRIBE_MAILTO=
# Weekly digest goes on Mondays at this hour, Africa/Kigali (0-23).
BK_DIGEST_HOUR=7

# --- Bootstrap: the first admin (decision 15). Real address only in your own .env. ---
BK_FIRST_ADMIN_EMAIL=owner@example.com

# --- Collectors and worker ---
# Public page saying who runs the bot and how to reach you; sent in the User-Agent
# as "BlackkiteBot/0.1 (+<url>)". Set it before any real fetch.
BK_BOT_CONTACT_URL=https://example.com/blackkite-bot
BK_FETCH_TIMEOUT_SECONDS=20
BK_FETCH_MAX_BYTES=5000000
# Seconds between requests to one host when a source sets no rate_limit (min 1).
BK_DEFAULT_RATE_LIMIT=5
# Cron (UTC) for sources with no schedule. 04:00 UTC is 06:00 in Kigali.
BK_DEFAULT_SOURCE_SCHEDULE=0 4 * * *
# Minutes after which a source run still "running" (and not locked by a live
# worker) is marked failed with "worker stopped".
BK_STALE_RUN_MINUTES=120
# Profile backfills: profiles scored per worker tick (after sources and alerts),
# and attempts before a failing backfill is given up (backoff 1, 5, 15, 60 min,
# then hourly; a new profile edit starts again).
BK_BACKFILL_PER_TICK=5
BK_BACKFILL_MAX_ATTEMPTS=6
# email_ingest sources: the shared inbox they read, over IMAP with TLS (port 993).
# Mailbox credentials live only here, never in a source's config. Leave empty
# until the owner sets up the inbox; email_ingest sources then fail cleanly.
BK_INGEST_IMAP_HOST=
BK_INGEST_IMAP_PORT=993
BK_INGEST_IMAP_USER=
BK_INGEST_IMAP_PASSWORD=
BK_INGEST_IMAP_TIMEOUT_SECONDS=30
# authserv-id your receiving mail server writes at the start of its
# Authentication-Results header (e.g. "mx.yourmailhost.example"). Only that
# header is trusted for dmarc/dkim; headers in the message with any other id are
# ignored. Required for email_ingest sources that require authenticated senders
# (the default): without it they refuse to run.
BK_INGEST_AUTHSERV_ID=

# --- Renderer service (decision 46): headless Chromium for browser_list ---
# browser_list pages are rendered by the separate `renderer` container, which
# holds no secrets. The api and worker reach it at BK_RENDERER_URL (compose sets
# http://renderer:8100 for them). Leave it empty outside compose: browser_list
# then uses a local headless browser with BK_ENV=dev and refuses to run otherwise.
BK_RENDERER_URL=
# Shared token: the renderer, api and worker all need the same value (compose
# refuses to start without it). At least 32 random characters, e.g.
# `openssl rand -hex 32`; example values and weak strings are refused at startup.
BK_RENDERER_TOKEN=
# Renderer-side ceilings (the renderer applies them whatever the caller asks):
# renders at once (one Chromium each), seconds a render may wait for a free
# browser before 503, per-render timeout, page and total bytes, requests per
# page, seconds per request, pause between requests to one host inside a
# render, pause between two renders on one host (min 1; robots Crawl-delay
# raises it), and the longest wait for a host's turn before a render is refused.
BK_RENDERER_MAX_CONCURRENT=2
BK_RENDERER_QUEUE_WAIT_SECONDS=30
BK_RENDERER_TIMEOUT_SECONDS=45
BK_RENDERER_MAX_BYTES=5000000
BK_RENDERER_TOTAL_BYTES=20000000
BK_RENDERER_MAX_REQUESTS=150
BK_RENDERER_REQUEST_TIMEOUT=20
BK_RENDERER_SUBRESOURCE_DELAY=0.25
BK_RENDERER_MIN_HOST_DELAY=1
BK_RENDERER_MAX_PACE_WAIT_SECONDS=30

# --- Models (decision 14) ---
BK_MODEL_EXTRACT=claude-haiku-5-5
BK_MODEL_SCORE=claude-haiku-5-5
BK_MODEL_DIGEST=claude-opus-5-5

# --- Third-party keys ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
BRAVE_API_KEY=
# Resend (BK_MAIL_TRANSPORT=resend). Provide it through the secure form only.
RESEND_API_KEY=

# --- Pipeline (api/blackkite/pipeline/settings.py) ---
# Downloaded detail pages and attachments, kept for extraction and the owner's
# reference only (never served to members).
BK_DATA_DIR=data
BK_DOCUMENT_MAX_BYTES=10000000
BK_DOCUMENTS_PER_ITEM=3
# Seconds allowed for extracting the text of one PDF; the extractor is killed after.
BK_PDF_TEXT_TIMEOUT_SECONDS=20
# Memory cap (MB, address space) for that extractor process; over it the PDF's
# text is skipped and recorded as the item's enrich error. Minimum 64.
BK_PDF_TEXT_MAX_MEMORY_MB=512
BK_EXTRACT_MAX_CHARS=40000
# Voyage AI embedding model (decision 12); output dimension is fixed at 1024.
BK_EMBEDDING_MODEL=voyage-3.5
BK_LLM_TIMEOUT_SECONDS=60

# --- Scoring (api/blackkite/scoring/settings.py); model is BK_MODEL_SCORE ---
# Component maxima, JSON; they should sum to 100 (spec 7).
BK_SCORE_WEIGHTS={"fit": 40, "eligibility": 20, "value": 15, "time": 15, "source": 10}
# Fit word thresholds (docs/api-contract.md section 1; flags do not change the word). JSON.
BK_SCORE_FIT_WORD={"strong_fit": 0.7, "strong_eligibility": 0.7, "good_fit": 0.6, "good_eligibility": 0.5, "possible_fit": 0.4}
# Shortlist (match stage): cosine similarity that alone shortlists a pair, and
# profile terms that must hit the item's tags/title.
BK_SCORE_EMBEDDING_MIN_SIMILARITY=0.45
BK_SCORE_TAG_MIN_OVERLAP=1
# Cost guard: model calls per scoring run; the rest are scored by rules and
# judged on a later run.
BK_SCORE_MAX_LLM_CALLS_PER_RUN=200
# Characters of notice text sent per scoring call.
BK_SCORE_TEXT_MAX_CHARS=12000
