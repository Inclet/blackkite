{#
  Pieces shared by the weekly digest and the urgent alert email. Email-safe:
  nested tables, inline styles, system fonts.
#}
{% set font = "font-family: Helvetica, Arial, sans-serif" %}
{% set table = 'role="presentation" cellpadding="0" cellspacing="0" border="0"' %}
{#
  One item: stream swatch and label, linked title, summary, optional value line
  (not on the board; shown only when the value is known), date line and trust note.
#}
{% macro item_block(item, last) %}
<tr>
<td style="padding: 12px 0; border-top: 1px solid #E7E5E0;{% if last %} border-bottom: 1px solid #E7E5E0;{% endif %}">
<table {{ table|safe }} width="100%" style="width: 100%; border-collapse: collapse">
<tr>
<td>
<table {{ table|safe }} style="border-collapse: collapse">
<tr>
<td width="9" style="width: 9px; vertical-align: middle"><div style="width: 9px; height: 9px; background: {{ item.swatch_colour }}; font-size: 0; line-height: 0">&nbsp;</div></td>
<td style="padding: 0 0 0 6px; vertical-align: middle; {{ font }}; font-size: 12px; font-weight: bold; color: {{ item.label_colour }}">{{ item.label }}</td>
</tr>
</table>
</td>
</tr>
<tr>
<td style="padding: 5px 0 0 0; {{ font }}; font-size: 17px; line-height: 23px; font-weight: bold"><a href="{{ item.url }}" style="{{ font }}; font-size: 17px; line-height: 23px; font-weight: bold; color: #2B2A28">{{ item.title }}</a></td>
</tr>
<tr>
<td style="padding: 5px 0 0 0; {{ font }}; font-size: 14px; line-height: 21px; color: #5F5D59">{{ item.summary }}</td>
</tr>
{% if item.value_line %}
<tr>
<td style="padding: 5px 0 0 0; {{ font }}; font-size: 14px; line-height: 21px; color: #2B2A28">{{ item.value_line }}</td>
</tr>
{% endif %}
<tr>
<td style="padding: 5px 0 0 0; {{ font }}; font-size: 14px; line-height: 21px; color: #2B2A28"><strong style="font-weight: bold">{{ item.date_line }}</strong>{% if item.trust_note %} · {{ item.trust_note }}{% endif %}</td>
</tr>
</table>
</td>
</tr>
{% endmacro %}
{#
  A list of items between rules, as on the board.
#}
{% macro item_list(items) %}
<table {{ table|safe }} width="100%" style="width: 100%; border-collapse: collapse">
{% for item in items %}
{{ item_block(item, loop.last) -}}
{% endfor %}
</table>
{% endmacro %}
